generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
  FAILED
}

enum EmailStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum EmailEventType {
  CREATED
  QUEUED
  PROCESSING
  SENT
  FAILED
  RESCHEDULED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders         Sender[]
  campaigns       Campaign[]
  slackConnection SlackConnection?
}

model Sender {
  id              String   @id @default(uuid())
  userId          String
  email           String
  displayName     String?
  hourlyLimit     Int      @default(100)
  minDelaySeconds Int      @default(5)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails       Email[]
  hourlyUsages HourlyUsage[]

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id          String         @id @default(uuid())
  userId      String
  name        String
  subject     String
  body        String         @db.Text
  status      CampaignStatus @default(DRAFT)
  totalEmails Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId, status])
}

model Email {
  id             String      @id @default(uuid())
  campaignId     String
  senderId       String
  recipientEmail String
  recipientName  String?
  subject        String
  body           String      @db.Text
  status         EmailStatus @default(SCHEDULED)
  scheduledAt    DateTime
  sentAt         DateTime?
  attempts       Int         @default(0)
  idempotencyKey String      @unique
  queueJobId     String?     @unique
  lastError      String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  campaign             Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender               Sender                  @relation(fields: [senderId], references: [id], onDelete: Restrict)
  events               EmailEvent[]
  rateLimitReservation HourlyUsageReservation?

  @@index([status, scheduledAt])
  @@index([campaignId])
  @@index([senderId, status])
  @@index([recipientEmail])
}

model SlackConnection {
  id                   String   @id @default(uuid())
  userId               String   @unique
  teamId               String
  teamName             String?
  accessTokenEncrypted String   @db.Text
  botUserId            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailEvent {
  id        String         @id @default(uuid())
  emailId   String
  type      EmailEventType
  message   String?        @db.Text
  metadata  Json?
  createdAt DateTime       @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
  @@index([type])
}

model HourlyUsage {
  id        String   @id @default(uuid())
  senderId  String
  hourStart DateTime
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender       Sender                   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reservations HourlyUsageReservation[]

  @@unique([senderId, hourStart])
  @@index([hourStart])
}

model HourlyUsageReservation {
  id            String   @id @default(uuid())
  emailId       String   @unique
  hourlyUsageId String
  createdAt     DateTime @default(now())

  email       Email       @relation(fields: [emailId], references: [id], onDelete: Cascade)
  hourlyUsage HourlyUsage @relation(fields: [hourlyUsageId], references: [id], onDelete: Cascade)

  @@index([hourlyUsageId])
}
